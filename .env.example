# Groq API key (fast, primary recommended): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API key (optional / backup): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider order: groq_first | gemini_first | groq | gemini
AI_PROVIDER=groq_first
